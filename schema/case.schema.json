{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/experience-atlas/case.schema.json",
  "title": "Experience Atlas Case",
  "type": "object",
  "required": ["id", "title", "framework", "status", "situation", "task", "actions", "results"],
  "properties": {
    "id": { "type": "string", "description": "Stable slug, snake_case" },
    "title": { "type": "string" },
    "role_at_time": { "type": "string", "description": "Фактическая роль в момент кейса" },
    "target_role": { "type": "string", "description": "Роль, под которую упаковываем (если reframe)" },
    "company": { "type": "string" },
    "product": { "type": "string" },
    "year": { "type": "string" },
    "framework": { "enum": ["STAR", "STAR+Learning", "Custom"] },
    "status": { "enum": ["completed", "in_progress", "planned"] },
    "target_grade_parameters": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Имена параметров из grade-matrix"
    },
    "business_goal": {
      "type": "array",
      "items": { "type": "string" }
    },
    "situation": { "type": "object" },
    "task": { "type": "object" },
    "actions": { "type": "array", "items": { "type": "string" } },
    "results": {
      "type": "object",
      "required": ["outcome"],
      "properties": {
        "outcome": { "type": "string" },
        "metrics": { "type": "object" },
        "qualitative": { "type": "array", "items": { "type": "string" } }
      }
    },
    "learnings": { "type": "array", "items": { "type": "string" } },
    "role_framing": {
      "type": "object",
      "description": "Линза для найма / смены роли",
      "properties": {
        "business_problem_headline": { "type": "string" },
        "problem_tags": { "type": "array", "items": { "type": "string" } },
        "hiring_pattern": { "type": "string" },
        "ownership_note": { "type": "string" },
        "metric_or_proof": { "type": "string" },
        "repeatable_elsewhere": { "type": "string" }
      }
    },
    "stakeholders": { "type": "array", "items": { "type": "string" } },
    "tools_and_methods": { "type": "array", "items": { "type": "string" } },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "next_steps": { "type": "array", "items": { "type": "string" } }
  }
}
